{
  "[python][javascript][javascriptreact][typescript][typescriptreact][yaml][css][scss][rust][dockerfile][c][cpp]": {
    "coc.preferences.formatOnSave": true
  },

  // General
  "inlayHint.enable": false,
  "signature.enable": true,
  "diagnostic.checkCurrentLine": true,
  "workspace.ignoredFolders": ["$HOME", "$HOME/.cargo/**", "$HOME/.rustup/**"],

  // ESLint & Prettier
  "eslint.enable": true,
  "eslint.autoFixOnSave": true,
  "eslint.filetypes": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "prettier.enable": true,
  "prettier.eslintIntegration": true,

  // HTML / JS / TS
  "html.format.enable": true,
  "javascript.autoClosingTags": true,
  "typescript.autoClosingTags": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "tsserver.enable": true,
  "tsserver.experimental.enableProjectDiagnostics": true,

  // Python
  "python.pythonPath": "python",
  "python.analysis.autoImportCompletions": true,
  "python.linting.pylintEnabled": true,
  "python.formatting.provider": "black",
  "python.formatting.blackPath": "black",
  "python.formatting.blackArgs": ["--fast"],
  "pyright.organizeimports.provider": "isort",
  "python.sortImports.path": "isort",
  "python.sortImports.args": ["--line-length", "120", "--profile", "black"],

  // Rust
  "rust-analyzer.imports.granularity.group": "module",
  "rust-analyzer.imports.prefix": "self",
  "rust-analyzer.imports.group.enable": true,
  "rust-analyzer.imports.sort": true,
  "rust-analyzer.diagnostics.enable": true,

  // YAML
  "yaml.schemas": {
    "kubernetes": "/*.yaml"
  },

  // C/C++
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=never",
  ],
  "suggest.autoTrigger": "always",
}
