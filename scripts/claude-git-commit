#!/bin/bash

# Parse command line arguments
amend_mode=false
args=()
for arg in "$@"; do
    if [ "$arg" = "--amend" ]; then
        amend_mode=true
    else
        args+=("$arg")
    fi
done

# Generate AI commit message using Claude
generate_ai_message() {
    # Get appropriate diff based on mode
    local diff_output
    if [ "$amend_mode" = true ]; then
        # For amend, show changes from HEAD~1 to current state
        diff_output=$(git diff HEAD~1)
    else
        # For normal commit, show staged changes
        diff_output=$(git diff --cached)
    fi
    
    if [ -z "$diff_output" ]; then
        if [ "$amend_mode" = true ]; then
            echo "Error: No changes to amend. The current commit is identical to HEAD~1." >&2
        else
            echo "Error: No staged changes found. Please stage your changes first with 'git add'." >&2
        fi
        exit 1
    fi
    
    local prompt
    if [ "$amend_mode" = true ]; then
        local current_message=$(git log -1 --pretty=%B)
        prompt="Based on the following git diff, create a concise commit message with:
    1. A succinct title (50 chars max)
    2. If necessary, up to 5 bullet points explaining the changes
    3. Do not add any other text or explanations

    This is for amending an existing commit. The current commit message is:
    $current_message

    Format:
    Title

    - Bullet point 1 (if needed)
    - Bullet point 2 (if needed)
    etc.

    Here's the diff:
    $diff_output"
        else
            prompt="Based on the following git diff of staged changes, create a concise commit message with:
    1. A succinct title (50 chars max)
    2. If necessary, up to 5 bullet points explaining the changes
    3. Never add any other text or explanations or a co-authered by line. Only the commit message.

    Format:
   Title

    - Bullet point 1 (if needed)
    - Bullet point 2 (if needed)
    etc.

    Here's the diff:
    $diff_output"
        fi
        echo "$prompt" | claude --print
    }

echo "Generating AI commit message..."
ai_message=$(generate_ai_message)

if [ $? -eq 0 ] && [ -n "$ai_message" ]; then
    if [ "$amend_mode" = true ]; then
        # For amend mode, always open editor with current message and AI suggestion
        temp_file=$(mktemp)
        current_message=$(git log -1 --pretty=%B)
        echo "# Current commit message:" > "$temp_file"
        echo "# $(echo "$current_message" | sed 's/^/# /')" >> "$temp_file"
        echo "#" >> "$temp_file"
        echo "# AI suggestion:" >> "$temp_file"
        echo "$ai_message" >> "$temp_file"
        ${EDITOR:-nano} "$temp_file"
        if [ -s "$temp_file" ]; then
            git commit --amend -F "$temp_file" "${args[@]}"
        else
            echo "Commit cancelled - empty message"
            exit 1
        fi
        rm "$temp_file"
    else
        # Normal mode - show options
        echo "Suggested commit message:"
        echo "------------------------"
        echo "$ai_message"
        echo "------------------------"
        echo
        read -p "Use this message? (y/n/e for edit): " choice
        
        case $choice in
            y|Y|yes|Yes)
                git commit -m "$ai_message" "${args[@]}"
                ;;
            e|E|edit|Edit)
                # Create temporary file with the message
                temp_file=$(mktemp)
                echo "$ai_message" > "$temp_file"
                ${EDITOR:-nano} "$temp_file"
                if [ -s "$temp_file" ]; then
                    git commit -F "$temp_file" "${args[@]}"
                else
                    echo "Commit cancelled - empty message"
                    exit 1
                fi
                rm "$temp_file"
                ;;
            *)
                echo "Commit cancelled"
                exit 1
                ;;
        esac
    fi
else
    echo "Failed to generate AI message. Falling back to regular commit."
    if [ "$amend_mode" = true ]; then
        git commit --amend "${args[@]}"
    else
        git commit "${args[@]}"
    fi
fi
