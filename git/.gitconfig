[user]
	name = Arthur Habicht
	email = arthur.habicht@helpany.com
	signingkey = 8DEC7F8A4A36931F
[alias]
    lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
    lg3 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
    c = commit
    cai = "!claude-git-commit"
    caia = "!claude-git-commit --amend"
    conflict = diff --name-only --diff-filter=U
    ch = checkout
    chm = "!git checkout $(git branch --list main master | sed 's/^* //')"
    rom = rebase origin/master
    ra = rebase --abort
    rc = rebase --continue
    riom = rom -i --autosquash
    fc = c --fixup
    s = status
    sw = switch
    d = diff
    dm = diff master
    dom = diff origin/master
    a = "!f() { git add \"$@\" && git s; }; f"
    p = push
    st = stash
    sta = stash apply
    please = push --force-with-lease
    po =  push -u origin @
    copy-branch = !git rev-parse --abbrev-ref HEAD | tr -d '\\n' | xclip -selection clipboard
    fall = fetch --all --tags --recurse-submodules=on-demand
    ctags = "!bash -c '[ -f .git/hooks/ctags ] || git init; .git/hooks/ctags' git-ctags"
    update-all = "!f() { \
          git fetch --all --tags --no-recurse-submodules && \
          git rebase && \
          git submodule update --init --recursive -j 8; \
      }; f"
    ua = "!git update-all"
    branch-clean-all-local = !git branch -vv | grep \": gone]\" | awk \"{print \\$1}\" | xargs git branch -D
    branch-clean-all-remote = !git remote prune origin

    # Make amend pushing faster
    amendpush = "!f() { \
      if [ \"$1\" = \"-f\" ]; then \
        git commit --amend --no-edit && git push --force-with-lease; \
      else \
        git commit --amend && git push --force-with-lease; \
      fi; \
    }; f"

    # Recent branches and stash for clean state
    clean-state = "!f() { \
        git update-all; \
        if [ \"$1\" = '--hard' ]; then \
          git reset --hard && git stash clear; \
        fi; \
      }; f"

    #Show what can be added to the index or stage changes
    af = "!f() { \
      files=$(git status --porcelain -u | awk '{print $2}' | fzf --multi --preview 'if git ls-files --error-unmatch -- {} >/dev/null 2>&1; then git diff --color=always -- {}; else batcat --style=plain --color=always {} ; fi' --preview-window=right:70%:wrap --bind 'tab:toggle+down'); \
      [ -n \"$files\" ] && echo \"$files\" | xargs git add; \
    }; f"

    #Show changes and make them revertible
    rf = "!f() { \
        files=$( \
            (echo '--- STAGED FILES ---'; git diff --cached --name-only; \
            echo ''; \
            echo '--- UNSTAGED FILES ---'; git diff --name-only) | \
            fzf --multi \
            --preview 'if git ls-files --error-unmatch -- {} >/dev/null 2>&1; then \
                          git diff --staged --color=always -- {} || git diff --color=always -- {}; \
                      else \
                          batcat --style=plain --color=always {} >/dev/null 2>&1; \
                      fi' \
            --preview-window=right:70%:wrap --bind 'tab:toggle+down'); \
        if [ -n \"$files\" ]; then \
            echo \"$files\" | while read file; do \
                if git diff --cached --name-only | grep -q \"$file\"; then \
                    git reset \"$file\"; \
                else \
                    git restore \"$file\"; \
                fi; \
            done; \
        fi; \
    }; f"

    # Show recently used branches
    b = "!git reflog -n 500 --pretty='%gs' | grep 'checkout' | awk '{print $NF}' | grep -v 'refs/remotes' | grep -v 'origin' | awk '!seen[$0]++' | fzf --height 10 --reverse | xargs git checkout"

    todo = grep -C 2 -n TODO
    todoa = grep -C 2 -n TODO_A


[core]
	editor = nvim
  pager = "type diff-so-fancy > /dev/null 2>&1 && diff-so-fancy | less -RFX '+r/^(Author|added|deleted|modified|renamed): ' || less -RFX"
	excludesfile = ~/.gitignore
[init]
  templatedir = ~/.git-templates
  defaultBranch = master
# Conflicts are resolved in nvim via fugitive's `:Gdiffsplit!` (3-way diff of
# both ancestors), so there is no `git mergetool` config here.
[pager]
  stash = false
  grep = false
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[help]
	# `1` meant "run the guessed command after 0.1s", which is no time to abort
	# a mistyped push/reset. `prompt` asks instead.
	autocorrect = prompt
[difftool]
	prompt = false
[color]
	ui = true
	diff = auto
	status = auto
	branch = auto
[pull]
  rebase = true
[rebase]
  autoStash = true
  autosquash = true
[status]
  showUntrackedFiles = all
[diff]
  # Don't walk submodule worktrees on every status: with 5-7 submodules that
  # cost 59ms vs 6ms. `dirty` hides uncommitted changes *inside* a submodule
  # but still reports a bumped submodule commit, which is what you'd commit.
  ignoreSubmodules = dirty
[submodule]
  recurse = true
[rerere]
  # Replays previous conflict resolutions. Worth it given pull.rebase +
  # rebase.autosquash below mean the same conflicts resurface often.
  enabled = true
[fetch]
  prune = true
[push]
  autoSetupRemote = true

# Must stay last: git applies config in order, so these have to come after the
# [user] block at the top to override user.email. The two paths are disjoint,
# so their order relative to each other does not matter. Anything outside both
# trees (~/.dotfiles included) still falls back to the [user] block above.
[includeIf "gitdir:~/repos/personal/"]
  path = ~/.gitconfig-personal
[includeIf "gitdir:~/repos/helpany/"]
  path = ~/.gitconfig-work
